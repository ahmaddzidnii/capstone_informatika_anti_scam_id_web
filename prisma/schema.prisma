generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTHENTICATION MODELS (GORM-Style)
// ==========================================

model User {
  id            String    @id @default(cuid(2))
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?

  // Role: "user" (Pengguna Umum) atau "admin" (Administrator)
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  sessions      Session[]
  accounts      Account[]
  checks        Check[]
  reports       Report[]       @relation("UserReports")
  reportReviews ReportReview[] @relation("AdminReviews")

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id             String    @id @default(cuid(2))
  expiresAt      DateTime  @map("expires_at")
  token          String    @unique
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?   @map("impersonated_by")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([identifier])
  @@index([deletedAt])
  @@map("verifications")
}

// ==========================================
// ANTISCAMID CORE MODELS (GORM-Style)
// ==========================================

model Check {
  id              String    @id @default(cuid(2))
  userId          String?   @map("user_id")
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Values: "WEB_TEXT" | "WEB_DOCUMENT" | "TELEGRAM_BOT"
  inputSource     String    @default("WEB_TEXT") @map("input_source")

  // Kebijakan privasi: teks disimpan hanya jika user menyetujui penyimpanan riwayat
  content         String?   @db.Text
  isContentSaved  Boolean   @default(false) @map("is_content_saved")

  // Hasil klasifikasi FastAPI: "SCAM" | "NORMAL" | "UNCERTAIN"
  predictionLabel String    @map("prediction_label")
  confidenceScore Float     @map("confidence_score")
  modelVersion    String    @map("model_version")

  // Indikator rule-based & saran tindakan
  indicators      String[]
  recommendation  String?   @db.Text
  latencyMs       Int?      @map("latency_ms")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  document        Document?
  report          Report?
  botInteraction  BotInteraction?

  @@index([userId])
  @@index([predictionLabel])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("checks")
}

model Document {
  id               String    @id @default(cuid(2))
  checkId          String    @unique @map("check_id")
  check            Check     @relation(fields: [checkId], references: [id], onDelete: Cascade)

  fileName         String    @map("file_name")
  mimeType         String    @map("mime_type")
  fileSize         Int       @map("file_size") // Maks 5 MB sesuai batasan proposal
  pageCount        Int?      @map("page_count") // Maks 5 halaman PDF

  // Status: "PENDING" | "SUCCESS" | "FAILED"
  extractionStatus String    @default("PENDING") @map("extraction_status")
  // Method: "PYMUPDF" | "TESSERACT"
  extractionMethod String?   @map("extraction_method")
  extractedText    String?   @db.Text @map("extracted_text")

  // Penghapusan file sementara setelah pemeriksaan selesai
  storagePath      String?   @map("storage_path")
  isPurged         Boolean   @default(false) @map("is_purged")
  purgedAt         DateTime? @map("purged_at")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  report           Report?

  @@index([deletedAt])
  @@map("documents")
}

model Report {
  id                String    @id @default(cuid(2))
  reporterId        String?   @map("reporter_id")
  reporter          User?     @relation("UserReports", fields: [reporterId], references: [id], onDelete: SetNull)

  checkId           String?   @unique @map("check_id")
  check             Check?    @relation(fields: [checkId], references: [id], onDelete: SetNull)

  documentId        String?   @unique @map("document_id")
  document          Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  content           String    @db.Text
  // Platform: "SMS" | "WHATSAPP" | "TELEGRAM" | "EMAIL" | "OTHER"
  platform          String
  // Modus: "FAKE_PRIZE" | "JOB_SCAM" | "BANK_IMPERSONATION" | "INVESTMENT" | "TRANSFER_REQUEST" | "OTP_PHISHING" | "OTHER"
  suspectedModus    String    @default("OTHER") @map("suspected_modus")
  suspiciousLink    String?   @map("suspicious_link")
  chronology        String?   @db.Text

  // Status: "PENDING" | "IN_REVIEW" | "VERIFIED_SCAM" | "INSUFFICIENT_EVIDENCE" | "REJECTED"
  status            String    @default("PENDING")
  isCleanForDataset Boolean   @default(false) @map("is_clean_for_dataset")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  reviews           ReportReview[]
  botInteraction    BotInteraction?

  @@index([status])
  @@index([suspectedModus])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("reports")
}

model ReportReview {
  id             String    @id @default(cuid(2))
  reportId       String    @map("report_id")
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  reviewerId     String    @map("reviewer_id")
  reviewer       User      @relation("AdminReviews", fields: [reviewerId], references: [id], onDelete: Restrict)

  previousStatus String    @map("previous_status")
  newStatus      String    @map("new_status")
  notes          String?   @db.Text

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([reportId])
  @@index([reviewerId])
  @@index([deletedAt])
  @@map("report_reviews")
}

model BotInteraction {
  id               String    @id @default(cuid(2))
  telegramUserId   String    @map("telegram_user_id")
  telegramChatId   String    @map("telegram_chat_id")
  telegramUsername String?   @map("telegram_username")
  command          String    // "/start" | "/cek" | "/lapor" | "/panduan" | "/bantuan"

  checkId          String?   @unique @map("check_id")
  check            Check?    @relation(fields: [checkId], references: [id], onDelete: SetNull)

  reportId         String?   @unique @map("report_id")
  report           Report?   @relation(fields: [reportId], references: [id], onDelete: SetNull)

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([telegramUserId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("bot_interactions")
}