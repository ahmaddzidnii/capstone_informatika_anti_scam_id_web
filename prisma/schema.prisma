generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum InputSource {
  WEB_TEXT
  WEB_DOCUMENT
  TELEGRAM_BOT
}

enum PredictionLabel {
  SCAM
  NORMAL
  UNCERTAIN
}

enum ExtractionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ExtractionMethod {
  PYMUPDF
  TESSERACT
}

enum ReportPlatform {
  SMS
  WHATSAPP
  TELEGRAM
  EMAIL
  OTHER
}

enum SuspectedModus {
  FAKE_PRIZE
  JOB_SCAM
  BANK_IMPERSONATION
  INVESTMENT
  TRANSFER_REQUEST
  OTP_PHISHING
  OTHER
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  VERIFIED_SCAM
  INSUFFICIENT_EVIDENCE
  REJECTED
}

// ==========================================
// AUTHENTICATION MODELS (Better Auth)
// ==========================================

model User {
  id            String    @id @default(cuid(2))
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?

  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  sessions      Session[]
  accounts      Account[]
  checks        Check[]
  reports       Report[]       @relation("UserReports")
  reportReviews ReportReview[] @relation("AdminReviews")

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id             String    @id @default(cuid(2))
  expiresAt      DateTime  @map("expires_at")
  token          String    @unique
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?   @map("impersonated_by")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid(2))
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@index([userId])
  @@index([deletedAt])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid(2))
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([identifier])
  @@index([deletedAt])
  @@map("verifications")
}

// ==========================================
// ANTISCAMID CORE MODELS
// ==========================================

model Check {
  id              String    @id @default(cuid(2))
  userId          String?   @map("user_id")
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  inputSource     InputSource    @default(WEB_TEXT) @map("input_source")
  content         String?   @db.Text

  predictionLabel PredictionLabel    @map("prediction_label")
  confidenceScore Float     @map("confidence_score")
  modelVersion    String    @default("v1") @map("model_version")

  indicators      String[]
  recommendation  String?   @db.Text
  latencyMs       Int?      @map("latency_ms")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  document        Document?
  report          Report?
  botInteraction  BotInteraction?

  @@index([userId])
  @@index([predictionLabel])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("checks")
}

model Document {
  id               String   @id @default(cuid(2))
  checkId          String   @unique @map("check_id")
  check            Check    @relation(fields: [checkId], references: [id], onDelete: Cascade)

  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  fileSize         Int      @map("file_size")
  pageCount        Int?     @map("page_count")

  extractionStatus ExtractionStatus   @default(PENDING) @map("extraction_status")
  extractionMethod ExtractionMethod?  @map("extraction_method")
  extractedText    String?  @db.Text @map("extracted_text")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  report           Report?

  @@map("documents")
}

model Report {
  id             String    @id @default(cuid(2))
  reporterId     String?   @map("reporter_id")
  reporter       User?     @relation("UserReports", fields: [reporterId], references: [id], onDelete: SetNull)

  checkId        String?   @unique @map("check_id")
  check          Check?    @relation(fields: [checkId], references: [id], onDelete: SetNull)

  documentId     String?   @unique @map("document_id")
  document       Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  content        String    @db.Text
  platform       ReportPlatform
  suspectedModus SuspectedModus    @default(OTHER) @map("suspected_modus")
  chronology     String?   @db.Text
  evidenceUrl    String?   @map("evidence_url")

  status         ReportStatus    @default(PENDING)

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  reviews        ReportReview[]
  botInteraction BotInteraction?

  @@index([status])
  @@index([suspectedModus])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("reports")
}

model ReportReview {
  id             String   @id @default(cuid(2))
  reportId       String   @map("report_id")
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  reviewerId     String   @map("reviewer_id")
  reviewer       User     @relation("AdminReviews", fields: [reviewerId], references: [id], onDelete: Restrict)

  previousStatus ReportStatus   @map("previous_status")
  newStatus      ReportStatus   @map("new_status")
  notes          String?  @db.Text

  createdAt      DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@index([reviewerId])
  @@map("report_reviews")
}

model BotInteraction {
  id               String   @id @default(cuid(2))
  telegramUserId   String   @map("telegram_user_id")
  telegramChatId   String   @map("telegram_chat_id")
  telegramUsername String?  @map("telegram_username")
  command          String

  checkId          String?  @unique @map("check_id")
  check            Check?   @relation(fields: [checkId], references: [id], onDelete: SetNull)

  reportId         String?  @unique @map("report_id")
  report           Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now()) @map("created_at")

  @@index([telegramUserId])
  @@index([createdAt])
  @@map("bot_interactions")
}