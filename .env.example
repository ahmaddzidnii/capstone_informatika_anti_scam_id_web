# Public base URL for Better Auth
BETTER_AUTH_URL=http://localhost:3000

# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=YOUR_SECRET_KEY_HERE

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anti_scam_id

# URL of the AI API with the OpenAPI spec at /openapi.json
AI_API_URL=http://localhost:3001

# Google OAuth credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# Optional application settings
LOG_LEVEL=info
NEXT_PUBLIC_APP_NAME=Anti Scam ID


TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_BOT_MODE=polling # "polling" or "webhook"
TELEGRAM_WEBHOOK_SECRET=YOUR_TELEGRAM_WEBHOOK_SECRET_HERE

# Set to "true" to use a mock AI API for testing, or "false" to use the real AI API
USE_MOCK_AI="true"